{
  "name": "devmentor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "npm run dev -w @devmentor/app --",
    "build": "npm run build -w @devmentor/app",
    "start": "npm run start -w @devmentor/app --",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:migrate": "npm run migrate -w @devmentor/db",
    "db:migration:create": "npm run migration:create -w @devmentor/db --",
    "db:migration:list": "npm run migration:list -w @devmentor/db"
  },
  "devDependencies": {
    "@devmentor/core": "*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.19.2",
    "agent-browser": "0.39.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
