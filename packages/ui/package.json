{
  "name": "@devmentor/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./backend/*": "./src/backend/*/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "test:storybook": "STORYBOOK_THEME=light vitest run --config vitest.storybook.config.ts --passWithNoTests && STORYBOOK_THEME=dark vitest run --config vitest.storybook.config.ts --passWithNoTests"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "shadcn": "^4.22.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "zod": "^4"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "msw": "^3.0.4",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "^1.65.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.6",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
