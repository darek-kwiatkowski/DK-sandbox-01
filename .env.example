# Copy to .env (repository root). Matches docker-compose.yml.
DATABASE_URL=postgresql://devmentor:devmentor@localhost:5432/devmentor

# Integration tests read TEST_DATABASE_URL from the shell environment (not from .env).
# It must point at a separate, disposable database: the tests drop its schema.
# TEST_DATABASE_URL=postgresql://devmentor:devmentor@localhost:5432/devmentor_test

# Log level for the shared pino logger: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# Signs session JWTs (HS256). At least 32 random bytes, e.g. `openssl rand -base64 48`.
# Never commit a real value. Requests needing a session are rejected while it is unset.
# AUTH_SECRET=
