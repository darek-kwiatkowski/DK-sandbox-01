{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["esnext", "dom"],
    "types": ["node"],
    // Type-checks the JSDoc of the dependency-free scripts in scripts/.
    "allowJs": true,
    "checkJs": true
  },
  "include": ["test/**/*.ts", "vitest*.config.ts", "scripts/**/*.ts", "scripts/**/*.mjs"]
}
